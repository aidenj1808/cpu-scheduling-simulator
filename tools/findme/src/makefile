findme: findme.c
	gcc -Wall -g findme.c -o findme

test_getopt: test_getopt.c
	gcc -Wall test_getopt.c -o test_getopt

test_getopt2: test_getopt2.c
	gcc -Wall test_getopt2.c -o test_getopt2

test_getopt_long: test_getopt_long.c
	gcc -Wall test_getopt_long.c -o test_getopt_long

clean:
	rm -f findme
	rm -f test_getopt
	rm -f test_getopt2
	rm -f test_getopt_long
